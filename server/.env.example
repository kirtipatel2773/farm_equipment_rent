# =============================================================================
# AgriRent Backend Environment Configuration Template
# Copy this file to .env and replace placeholders with your local environment values
# =============================================================================

# Server Port
PORT=5000

# Allowed Frontend URL (CORS Origin)
FRONTEND_URL=http://localhost:5173

# MySQL Database Connection Details
DB_HOST=localhost
DB_PORT=3306
DB_USER=agrirent_app
DB_PASSWORD=replace_with_your_local_password
DB_NAME=agrirent_db

# JWT Secret for User Session Tokens
JWT_SECRET=replace_with_a_long_random_secret_agrirent_2026
JWT_EXPIRES_IN=7d
